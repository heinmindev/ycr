{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Time": {
    "LocalTimeZone": "Asia/Yangon"
  },
  "Auth": {
    "Issuer": "YCR.Api",
    "Audience": "YCR.Api",
    "PrincipalCacheSeconds": 15,
    "AllowedOrigins": [],
    "RateLimits": {
      "LoginPerUserNamePerMinute": 5,
      "LoginPerClientAddressPerMinute": 20,
      "RefreshPerClientAddressPerMinute": 30
    }
  }
}
