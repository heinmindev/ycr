{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "YCR.Api",
    "Audience": "YCR.Api",
    "AccessTokenLifetime": "00:15:00",
    "SessionLifetime": "12:00:00",
    "RefreshGraceWindow": "00:00:20",
    "PrincipalCacheSeconds": 15,
    "AllowedOrigins": [],
    "RateLimits": {
      "LoginPerUserNamePerMinute": 5,
      "LoginPerClientAddressPerMinute": 20,
      "RefreshPerClientAddressPerMinute": 30
    }
  }
}
