<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Per-developer secrets (the ES256 dev signing key, D11; ADR-0023 item 7) live in
    dotnet user-secrets under this id, loaded in Development only — never in the repository.
  -->
  <PropertyGroup>
    <UserSecretsId>ycr-api-4f0d2c8e-7b1a-4f5e-9c3d-2a6e8b1f0c57</UserSecretsId>
  </PropertyGroup>

  <!--
    Minimal API host. May depend on no YCR.Domain.<Module> type, and from
    YCR.Domain.Common only Result, Result<T>, Error and ErrorType (plan P11).
    An architecture test enforces that allowlist.
  -->
  <ItemGroup>
    <ProjectReference Include="../YCR.Application/YCR.Application.csproj" />
    <ProjectReference Include="../YCR.Infrastructure/YCR.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FluentValidation behind an endpoint filter (docs/20 section 3). The bundled
      FluentValidation.AspNetCore package is deprecated, so the filter is wired by hand.
    -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- OpenAPI document for YCR.Api.http and client generation; Development only at runtime. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Scalar API reference UI over that same document; Development only at runtime (T-021). -->
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- /health/ready must report database connectivity (docs/02 section Reliability). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- The framework JwtBearerHandler, the only scheme the guard allows (ADR-0020 item 5 as amended; ADR-0023). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
