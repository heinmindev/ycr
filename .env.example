# Local development only. Copy to .env and set real values; .env is git-ignored.
# Nothing here is a default: docker-compose.yml fails fast when a value is missing, so a
# known password can never reach a running server by accident.
#
# Automated tests do not read this file — they generate a password per container.

# sa password for the local SQL Server container. SQL Server enforces its password policy.
MSSQL_SA_PASSWORD=

# Password for the ycr_app login: the credential the application runs under (ADR-0017 item 3).
YCR_APP_PASSWORD=

# Password for the ycr_migrator login: the only credential allowed to apply migrations.
YCR_MIGRATOR_PASSWORD=

# Optional overrides.
YCR_DATABASE=YCR
MSSQL_PORT=1433

# --- Connection strings ---------------------------------------------------------------------
#
# Both pin `Current Language=us_english` (hein's ruling, 2026-09-20). SQL Server localises error
# messages by session language, and SqlServerUniqueConstraintTranslator reads a violated
# constraint's name out of the message text because no API exposes it. On a session in another
# language it would silently stop recognising duplicates. Do not drop this setting.
#
# The migrator credential applies migrations and nothing else; the application credential runs
# the platform and holds only the ycr_app role (ADR-0017 item 3).
#
# YCR_MIGRATOR_CONNECTION=Server=localhost,1433;Database=YCR;User Id=ycr_migrator;Password=...;TrustServerCertificate=True;Current Language=us_english
# YCR_APPLICATION_CONNECTION=Server=localhost,1433;Database=YCR;User Id=ycr_app;Password=...;TrustServerCertificate=True;Current Language=us_english

# --- Staff authentication (F-002) -----------------------------------------------------------
#
# The API refuses to start outside Development/Testing unless at least one allowed origin is set
# (R9: login, refresh and logout reject any other Origin). Origins are exact: scheme, host, port.
#
# Auth__AllowedOrigins__0=https://ycr.example
#
# The ES256 signing key is NEVER put in this file or any committed file (R14, D11). In Development
# it lives in `dotnet user-secrets` (see README "Developer setup"); in a deployment it comes from the
# environment's secret store as Auth__Signing__ActiveKeyId and Auth__Signing__Keys__0__* values.
# Production refuses a key marked DevelopmentOnly or whose kid starts with dev- or test- (S26a).
