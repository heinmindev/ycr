<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Shared test-project settings, so seven csproj files do not repeat them.
    xUnit v3 test projects are executables (plan P3).

    YCR.TestSupport lives under tests/ but is a fixture library, not a test
    project: it must not pull in the test runner, or `dotnet test` treats it
    as a test assembly with nothing to run.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'YCR.TestSupport'">
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <!--
    Trunk-only tests are EXCLUDED here, not skipped (spec E5, plan review item 7).

    They pull a second multi-gigabyte SQL Server image or write 10,000 rows, which the plan
    judged too expensive for every branch build. Skipping them would report "skipped: N" and
    break S15's "no skipped tests"; excluding them by trait keeps the branch run at zero
    skipped while leaving the tests real and runnable.

    The trunk job runs exactly the complement, passing the filter-trait option with
    Category=TrunkOnly. Set YCR_RUN_TRUNK_ONLY_TESTS=1 to run them locally.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'YCR.TestSupport' AND '$(YCR_RUN_TRUNK_ONLY_TESTS)' == ''">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --filter-not-trait "Category=TrunkOnly"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'YCR.TestSupport'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
